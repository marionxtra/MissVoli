{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/newsletter/**",
              "ui_kits/pedagogie/**",
              "ui_kits/print/**",
              "ui_kits/reseaux_sociaux/**",
              "ui_kits/site_web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fredoka|DM Sans))/i]",
        "message": "Font not provided by the design system. Available: Fredoka, DM Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:soft|success|brand|outline|cream)$/]",
        "message": "<Badge> tone must be one of 'soft' | 'success' | 'brand' | 'outline' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|href|fullWidth|iconLeft|iconRight|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, href, fullWidth, iconLeft, iconRight, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|onBrand)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'onBrand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|padding|as|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, padding, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:white|cream|outline|brand)$/]",
        "message": "<Card> variant must be one of 'white' | 'cream' | 'outline' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|type|multiline|rows|id|placeholder|value|defaultValue|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, type, multiline, rows, id, placeholder, value, defaultValue, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|showWordmark|basePath|tone|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, showWordmark, basePath, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|ink|cream)$/]",
        "message": "<Logo> tone must be one of 'brand' | 'ink' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:pin|title|children|badge|pinSize|basePath|variant|href|key|ref|className|style|children)$/]",
        "message": "<PinCard> doesn't accept that prop. Declared props: pin, title, children, badge, pinSize, basePath, variant, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:white|cream|outline|brand)$/]",
        "message": "<PinCard> variant must be one of 'white' | 'cream' | 'outline' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|basePath|shadow|alt|style|key|ref|className|style|children)$/]",
        "message": "<PinIcon> doesn't accept that prop. Declared props: name, size, basePath, shadow, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PinIcon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:miss-voli|mistakes-welcome|cinema|dialogues|diplome|en-ligne|fearless|globe-trotter|jeux|lyon|musique|niveau|sessions|sorties|tea|th|travail|vacances)$/]",
        "message": "<PinIcon> name must be one of 'miss-voli' | 'mistakes-welcome' | 'cinema' | 'dialogues' | 'diplome' | 'en-ligne' | 'fearless' | 'globe-trotter' | 'jeux' | 'lyon' | 'musique' | 'niveau' | 'sessions' | 'sorties' | 'tea' | 'th' | 'travail' | 'vacances'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|align|level|tone|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, lead, align, level, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<SectionHeading> level must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|cream)$/]",
        "message": "<SectionHeading> tone must be one of 'ink' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickerBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:height|iconSize|gap|tone|style|key|ref|className|style|children)$/]",
        "message": "<StickerBand> doesn't accept that prop. Declared props: height, iconSize, gap, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickerBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|cream|ink)$/]",
        "message": "<StickerBand> tone must be one of 'brand' | 'cream' | 'ink'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
